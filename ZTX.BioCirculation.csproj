<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ZTX.BioCirculation</AssemblyName>
    <RootNamespace>ZTX.BioCirculation</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- CS0649: rules fields are assigned by Halfling's reflective deserializer, not by C# code. -->
    <NoWarn>$(NoWarn);CA1416;CS0649</NoWarn>
    <CosmoteerBin Condition="'$(CosmoteerBin)' == ''">D:\SteamLibrary\steamapps\common\Cosmoteer\Bin</CosmoteerBin>
    <YamlModDir Condition="'$(YamlModDir)' == ''">D:\SteamLibrary\steamapps\workshop\content\799600\3577650065</YamlModDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Cosmoteer"><HintPath>$(CosmoteerBin)\Cosmoteer.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HalflingCore"><HintPath>$(CosmoteerBin)\HalflingCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(YamlModDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
    <Publicize Include="Cosmoteer" />
    <!-- These events are already public in vanilla; publicizing their compiler-generated
         private backing fields (same name) makes every reference ambiguous (CS0229). -->
    <DoNotPublicize Include="Cosmoteer:Cosmoteer.Ships.Parts.CommonBasePartsManager`1.PartAdded" />
    <DoNotPublicize Include="Cosmoteer:Cosmoteer.Ships.Parts.CommonBasePartsManager`1.PartRemoved" />
    <Publicize Include="HalflingCore" />
  </ItemGroup>
</Project>
